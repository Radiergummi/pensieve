.DS_Store
.superpowers/
.build/

# Xcode (generated by XcodeGen; project.yml is the source of truth)
Pensieve.xcodeproj/
.build-xcode/

# Makefile step records — "this ran and passed against these sources"
.make/
Sources/PensieveApp/Info.plist
Sources/PensieveWidget/Info.plist
.swiftpm/

# Eval harness — private work text + run outputs, never committed
.eval/

.worktrees/

# Claude Code worktree checkouts. Narrowed to `/*` so skills can be re-included:
# git cannot re-include a path whose parent directory is excluded.
.claude/*
!.claude/skills/

    "Delete “%@” and everything nested under it? Captured activity and loose ends are removed. This can’t be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ und alles darin Verschachtelte löschen? Erfasste Aktivität und offene Enden werden entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%(node)@” and everything nested under it? Captured activity and loose ends are removed. This can’t be undone."

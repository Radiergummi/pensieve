    "Builds an on-device index so ⌘F and Claude Code can find work by meaning, not just exact words. First use downloads a small on-device model." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt einen geräteinternen Index, damit ⌘F und Claude Code Arbeit nach Bedeutung finden, nicht nur nach exakten Wörtern. Bei der ersten Nutzung wird ein kleines geräteinternes Modell geladen."
          }
        }
      }
    },

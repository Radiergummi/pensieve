<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The ONLY entitlement this app carries. Deliberately absent: com.apple.security.app-sandbox
	     and hardened runtime. Pensieve reads ~/Library/Application Support directly and shells out
	     to `claude -p`; sandboxing it would break both.

	     The group id uses the `group.` prefix, NOT the Team-ID-prefixed form: only `group.…` can be
	     registered as an App Group in Apple's Developer portal, and that registration is the
	     prerequisite for the Mac Development provisioning profile. Until a profile is embedded,
	     `secd` logs "Entitlement …application-groups… is ignored" on every launch and the sandboxed
	     widget gets no container — this app does not notice, because unsandboxed processes get no
	     entitlement check and write the path directly.

	     PensieveWidget.entitlements MUST carry this identical string. A shared App Group requires the
	     same identifier on every member; mismatch them and
	     containerURL(forSecurityApplicationGroupIdentifier:) returns nil in the sandboxed member with
	     no diagnostic. Keep both files and PensievePaths.appGroupIdentifier in lockstep. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.me.mazetti.pensieve</string>
	</array>
</dict>
</plist>

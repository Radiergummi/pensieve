<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The ONLY entitlement this app carries. Deliberately absent: com.apple.security.app-sandbox
	     and hardened runtime. Pensieve reads ~/Library/Application Support directly and shells out
	     to `claude -p`; sandboxing it would break both.

	     Because the app is NOT sandboxed, the group id MUST carry the Team-ID prefix
	     (TH593VRB6W.…). A sandboxed member of the same group — the widget, later — uses the plain
	     `group.` form instead. Get the form wrong and
	     containerURL(forSecurityApplicationGroupIdentifier:) returns nil with no diagnostic. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>TH593VRB6W.me.mazetti.pensieve</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The ONLY entitlement this app carries. Deliberately absent: com.apple.security.app-sandbox
	     and hardened runtime. Pensieve reads ~/Library/Application Support directly and shells out
	     to `claude -p`; sandboxing it would break both.

	     The group id carries the Team-ID prefix (TH593VRB6W.…). A shared App Group requires the
	     identical identifier on every member, sandboxed or not — PensieveWidget.entitlements uses
	     this same TH593VRB6W-prefixed string, not the plain `group.` form. Whether a sandboxed
	     macOS app extension actually accepts the Team-ID-prefixed form is not yet runtime-verified:
	     no provisioning profile has been minted for the widget. Get the group id wrong (or
	     mismatched between the two files) and containerURL(forSecurityApplicationGroupIdentifier:)
	     returns nil with no diagnostic. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>TH593VRB6W.me.mazetti.pensieve</string>
	</array>
</dict>
</plist>
